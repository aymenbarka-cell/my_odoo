<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="stock_picking_form_inherit_remarque" model="ir.ui.view">
        <field name="name">stock.picking.form.inherit.remarque_bd</field>
        <field name="model">stock.picking</field>
        <field name="inherit_id" ref="stock.view_picking_form"/>
        <field name="arch" type="xml">
            <xpath expr="//notebook" position="inside">
                <page string="Remarque">
                    <field name="remarque_bd" placeholder="Ajoutez vos remarques ici..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
