<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="view_order_form_inherit_remarque" model="ir.ui.view">
        <field name="name">sale.order.form.inherit.remarque</field>
        <field name="model">sale.order</field>
        <field name="inherit_id" ref="sale.view_order_form"/>
        <field name="arch" type="xml">
            <!-- Add new notebook page after existing pages -->
            <xpath expr="//notebook" position="inside">
                <page string="Remarque">
                    <field name="remarque" placeholder="Ajoutez vos remarques ici..."/>
                </page>
            </xpath>
        </field>
    </record>
</odoo>
