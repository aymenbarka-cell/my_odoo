<?xml version="1.0"?>

<odoo>

    <record id="view_sale_order_formation_form" model="ir.ui.view">
            <field name="name">sale order formation .MF</field>
            <field name="model">sale.order</field>
            <field name="inherit_id" ref="sale.view_order_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//field[@name='payment_term_id']" position="after">
                            <field name="remarque" />
                            <field name="client_f_id" />
                    </xpath>
                </field>
    </record>
</odoo>