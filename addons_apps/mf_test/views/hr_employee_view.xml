<?xml version="1.0"?>

<odoo>

    <record id="view_hr_employe_formation_form" model="ir.ui.view">
            <field name="name">employee  formation .MF</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
                <field name="arch" type="xml">
                    <xpath expr="//field[@name='coach_id']" position="after">
                            <field name="moyenne" />
                        </xpath>
                    <xpath expr="//div[@name='button_box']" position="inside">
                <button name="affiche_formation" icon="fa-list" type="object">
                    <div class="o_stat_info">
                        <span class="o_stat_text">     <field name="nbf" /></span>
                        <span class="o_stat_text">FORMATION</span>
                    </div>
                </button>
            </xpath>
                </field>
    </record>
</odoo>