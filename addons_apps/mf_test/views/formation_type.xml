<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>
        <record id="view_form_formation_type" model="ir.ui.view">
            <field name="name">formation.type   form</field>
            <field name="model">formation.type</field>
            <field name="arch" type="xml">
                <form >
                    <sheet>
                        <group>
                            <group string ="Information global">
                                <field name="name"/>
                                <field name="description"/>
                            </group>
                        </group>
                    </sheet>
                </form>
            </field>
        </record>
        <record id="view_formation_type_tree" model="ir.ui.view">
            <field name="name">formation   type la .list</field>
            <field name="model">formation.type</field>
            <field name="arch" type="xml">
                <list string="formation salle" >
                    <field name="name"/>
                    <field name="description"/>
                </list>
            </field>
        </record>


    <record model='ir.actions.act_window' id='formation_type_action'>
        <field name="name">Formation type</field>
        <field name="res_model">formation.type</field>
        <field name="type">ir.actions.act_window</field>
        <field name="view_mode">list,form</field>
    </record>

<!--menu de la table type de formation-->
	<menuitem
            id="formation_type_menu"
            parent="formation_menu"
            action="formation_type_action"
            sequence="10" />

        </data>

</odoo>
