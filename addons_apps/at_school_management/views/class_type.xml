<odoo>
    <record id="view_school_class_type_list" model="ir.ui.view">
        <field name="name">school.class.type.list</field>
        <field name="model">school.class.type</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="monthly_fee"/>
                <field name="description"/>
                <field name="active"/>
            </list>
        </field>
    </record>

    <record id="view_school_class_type_form" model="ir.ui.view">
        <field name="name">school.class.type.form</field>
        <field name="model">school.class.type</field>
        <field name="arch" type="xml">
            <form string="Class Type">
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="monthly_fee"/>
                        <field name="description"/>
                        <field name="active"/>
                    </group>
                </sheet>
            </form>
        </field>
    </record>

    <record id="action_school_class_type" model="ir.actions.act_window">
        <field name="name">Class Types</field>
        <field name="res_model">school.class.type</field>
        <field name="view_mode">list,form</field>
    </record>
    <menuitem id="menu_school_root"
          name="School Management"
          sequence="1"/>

    <menuitem id="menu_school_class_type"
              name="Class Types"
              parent="menu_school_root"
              action="action_school_class_type"
              sequence="15"/>
</odoo>
