<?xml version="1.0" encoding="utf-8"?>
<odoo>
  <record id="view_app_creator_form" model="ir.ui.view">
    <field name="name">app.creator.form</field>
    <field name="model">app.creator</field>
    <field name="arch" type="xml">
      <form string="App Creator">
        <sheet>
          <group>
            <field name="name"/>
            <field name="technical_name"/>
            <field name="description"/>
            <field name="author"/>
            <field name="version"/>
            <field name="created_path" readonly="1"/>
          </group>
          <footer>
            <button string="Generate Module" name="action_generate_module" type="object" class="btn-primary"/>
            <button string="Close" class="btn-default" special="cancel"/>
          </footer>
        </sheet>
      </form>
    </field>
  </record>

  <record id="view_app_creator_tree" model="ir.ui.view">
    <field name="name">app.creator.tree</field>
    <field name="model">app.creator</field>
    <field name="arch" type="xml">
      <list>
        <field name="name"/>
        <field name="technical_name"/>
        <field name="created_path"/>
      </list>
    </field>
  </record>

  <record id="action_app_creator" model="ir.actions.act_window">
    <field name="name">App Creator</field>
    <field name="res_model">app.creator</field>
    <field name="view_mode">list,form</field>
  </record>

  <menuitem id="menu_app_creator_root" name="App Tools" sequence="10"/>
  <menuitem id="menu_app_creator" name="App Creator" parent="menu_app_creator_root" action="action_app_creator"/>
</odoo>
