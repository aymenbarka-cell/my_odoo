<odoo>
  <data>
    <record id="view_courrier_archive_list" model="ir.ui.view">
      <field name="name">courrier.archive.list</field>
      <field name="model">courrier.archive</field>
      <field name="arch" type="xml">
        <list>
          <field name="courrier_id"/>
          <field name="department_id"/>
          <field name="desk_id"/>
          <field name="archived_by"/>
          <field name="archive_date"/>
        </list>
      </field>
    </record>

    <record id="view_courrier_archive_form" model="ir.ui.view">
      <field name="name">courrier.archive.form</field>
      <field name="model">courrier.archive</field>
      <field name="arch" type="xml">
        <form string="Archive Entry">
          <sheet>
            <group>
              <field name="courrier_id"/>
              <field name="department_id"/>
              <field name="desk_id"/>
              <field name="note"/>
              <field name="archived_by"/>
              <field name="archive_date"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_courrier_archive" model="ir.actions.act_window">
      <field name="name">Archived Courriers</field>
      <field name="res_model">courrier.archive</field>
      <field name="view_mode">list,form</field>
    </record>
  </data>
</odoo>
