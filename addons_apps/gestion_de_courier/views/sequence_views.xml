<odoo>
  <data>
    <record id="view_courrier_sequence_list" model="ir.ui.view">
      <field name="name">courrier.sequence.list</field>
      <field name="model">ir.sequence</field>
      <field name="arch" type="xml">
        <list>
          <field name="name"/>
          <field name="code"/>
          <field name="prefix"/>
          <field name="padding"/>
          <field name="number_next"/>
        </list>
      </field>
    </record>

    <record id="view_courrier_sequence_form" model="ir.ui.view">
      <field name="name">courrier.sequence.form</field>
      <field name="model">ir.sequence</field>
      <field name="arch" type="xml">
        <form string="Courrier Sequence">
          <sheet>
            <group>
              <field name="name"/>
              <field name="code"/>
              <field name="prefix"/>
              <field name="padding"/>
              <field name="number_next"/>
            </group>
          </sheet>
        </form>
      </field>
    </record>

    <record id="action_courrier_sequences" model="ir.actions.act_window">
      <field name="name">Numérotation Courrier</field>
      <field name="res_model">ir.sequence</field>
      <field name="view_mode">list,form</field>
      <field name="domain">[('code', 'in', ('courrier.incoming','courrier.outgoing','courrier.internal'))]</field>
    </record>
  </data>
</odoo>
