<?xml version="1.0" encoding="utf-8"?>
<odoo>
        <record id="view_hr_employee_form" model="ir.ui.view">
            <field name="name">hr employee MF</field>
            <field name="model">hr.employee</field>
            <field name="inherit_id" ref="hr.view_employee_form"/>
            <field name="arch" type="xml">
                <xpath expr="//field[@name='coach_id']" position="after">
                    <field name="moyenne"/>
                    <field name="nbf" />
                </xpath>

                <xpath expr="//div[@name='button_box']" position="inside">
                    <button name="Affiche_formation" type="object"  icon="fa-list">
                        <span class="o_stat_text"><field name="nbf"/> </span>
                        <span class="o_stat_text">FORMATION</span>
                    </button>
                </xpath>
            </field>

        </record>

</odoo>
