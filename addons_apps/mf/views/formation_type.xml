<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <data>

        <record id="view_form_formation_type" model="ir.ui.view">
            <field name="name">formation.type form</field>
            <field name="model">formation.type</field>
            <field name="arch" type="xml">
                <form string="Tags">
                    <sheet>
                        <group>
                            <group string="Information globale">
                                <field name="name"/>
                                 <field name="ref"/>
                                <field name="description"/>
                            </group>

                        </group>

                    </sheet>
                </form>
            </field>
        </record>

        <record id="view_form_formation_type_2" model="ir.ui.view">
            <field name="name">formation.type la liste</field>
            <field name="model">formation.type</field>
            <field name="arch" type="xml">
                <list string="formation type" type="xml">

                        <field name="ref"/>
                </list>
            </field>
        </record>


        <record id="formation_action_type" model="ir.actions.act_window">
            <field name="name">type</field>
            <field name="res_model">formation.type</field>
            <field name="type">ir.actions.act_window</field>
            <field name="view_mode">list,form</field>

        </record>


         <menuitem
        id="formation_type_menu"
        parent="formation_menu"
        action="formation_action_type"
        sequence="1"/>
    </data>
</odoo>
