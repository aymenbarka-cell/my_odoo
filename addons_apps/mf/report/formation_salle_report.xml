<?xml version="1.0" encoding="utf-8"?>
<odoo>
    <record id="report_formation_salle" model="ir.actions.report">
        <field name="name">Fiche de salle</field>
        <field name="model">formation.salle</field>
        <field name="report_type">qweb-pdf</field>
        <field name="report_name">mf.template_formation_salle</field>
        <field name="report_file">mf.template_formation_salle</field>
        <field name="binding_model_id" ref="model_formation_salle"/>
        <field name="binding_type">report</field>
    </record>

    <template id="template_formation_salle">
        <t t-foreach="docs" t-as="o">
            <t t-call="web.html_container">
                <t t-call="web.basic_layout">

                    <div class="page">La salle de formation :
                        <b>
                            <t t-esc="o.name"/>
                        </b>
                        <br/>
                        <b>
                            <t t-esc="o.nb_place"/>
                        </b>
                        <br/>
                        <b>
                            <t t-esc="o.date_creation"/>
                        </b>
                        <br/>
                        <b>
                            <t t-esc="o.if_machine"/>
                        </b>
                        <br/>
                        <b>
                            <t t-esc="o.type_class"/>
                        </b>
                        <br/>
                        <b>
                            <t t-esc="o.status"/>
                        </b>
                    </div>
                </t>
            </t>
        </t>

    </template>
</odoo>
