<odoo>
    <record id="view_users_form_inherit_doc_access" model="ir.ui.view">
        <field name="name">res.users.form.inherit.doc.access</field>
        <field name="model">res.users</field>
        <field name="inherit_id" ref="base.view_users_form"/>
        <field name="arch" type="xml">
            <xpath expr="//page[@name='access_rights']" position="after">
                <page name="document_access" string="Document Archive Access">
                    <field name="document_access_ids" nolabel="1">
                        <list editable="bottom">
                            <field name="direction_id"/>
                            <field name="department_id"/>
                            <field name="section_id"/>
                            <field name="desk_id"/>
                            <field name="category_ids" widget="many2many_tags"/>
                            <field name="permission_level"/>  
                        </list>
                    </field>
                </page>
            </xpath>
        </field>
    </record>
</odoo>