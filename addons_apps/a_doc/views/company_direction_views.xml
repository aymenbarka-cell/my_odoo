<odoo>
    <record id="view_direction_list" model="ir.ui.view">
        <field name="name">document.direction.list</field>
        <field name="model">document.direction</field>
        <field name="arch" type="xml">
            <list>
                <field name="name"/>
                <field name="code"/>
            </list>
        </field>
    </record>

    <record id="view_direction_form" model="ir.ui.view">
        <field name="name">document.direction.form</field>
        <field name="model">document.direction</field>
        <field name="arch" type="xml">
            <form>
                <sheet>
                    <group>
                        <field name="name"/>
                        <field name="code"/>
                    </group>
                    <notebook>
                        <page string="Departments">
                            <field name="department_ids">
                                <list editable="bottom">
                                    <field name="name"/>
                                    <field name="code"/>
                                </list>
                            </field>
                        </page>
                    </notebook>
                </sheet>
            </form>
        </field>
    </record>
</odoo>