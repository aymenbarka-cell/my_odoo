<!-- views/menu.xml -->
<odoo>

    <!-- ROOT MENU -->
    <menuitem id="menu_document_root" name="Document Archive" sequence="10"/>

    <!-- ========== ACTIONS (MUST COME FIRST) ========== -->

    <record id="action_direction" model="ir.actions.act_window">
        <field name="name">Directions</field>
        <field name="res_model">document.direction</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_department" model="ir.actions.act_window">
        <field name="name">Departments</field>
        <field name="res_model">document.department</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_section" model="ir.actions.act_window">
        <field name="name">Sections</field>
        <field name="res_model">document.section</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_desk" model="ir.actions.act_window">
        <field name="name">Desks</field>
        <field name="res_model">document.desk</field>
        <field name="view_mode">list,form</field>
    </record>

    <record id="action_document" model="ir.actions.act_window">
        <field name="name">Archived Documents</field>
        <field name="res_model">document.archive</field>
        <field name="view_mode">list,form</field>
    </record>
    <!-- =============== DASHBOARD ACTION =============== -->

<record id="action_document_dashboard" model="ir.actions.act_window">
    <field name="name">Document Dashboard</field>
    <field name="res_model">document.archive</field>
    <field name="view_mode">pivot,graph,list</field>
    <field name="view_id" ref="view_document_pivot_department"/>
</record>

    <!-- ========== MENUS (AFTER ACTIONS) ========== -->

    <menuitem id="menu_direction"
              name="Directions"
              parent="menu_document_root"
              action="action_direction"/>

    <menuitem id="menu_department"
              name="Departments"
              parent="menu_document_root"
              action="action_department"/>

    <menuitem id="menu_section"
              name="Sections"
              parent="menu_document_root"
              action="action_section"/>

    <menuitem id="menu_desk"
              name="Desks"
              parent="menu_document_root"
              action="action_desk"/>

    <menuitem id="menu_document"
              name="Documents"
              parent="menu_document_root"
              action="action_document"/>

    <menuitem id="menu_document_dashboard"
          name="Dashboard"
          parent="menu_document_root"
          action="action_document_dashboard"
          sequence="1"/>          

</odoo>